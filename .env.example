# =====================================================================
#  AI WhatsApp Group Summarizer — settings
#
#  Easiest: run `npm run setup` and answer a few questions; it writes .env
#  and generates every secret for you.
#  Manual: copy this file to .env, fill it in, then: chmod 600 .env
#  Generate secrets with: npm run secret
# =====================================================================

# ---------------------------------------------------------------------
# 1) AI provider (any OpenAI-compatible API). Keep ONE block uncommented.
# ---------------------------------------------------------------------

# --- Groq (recommended: free, says it does not train on your data) ---
AI_URL=https://api.groq.com/openai/v1/chat/completions
AI_KEY=put_your_key_here
AI_MODEL=openai/gpt-oss-120b
# Groq's free tier has a small tokens-per-minute limit, so use small chunks
# and wait a minute between them.
CHUNK_SIZE=8000
CHUNK_WAIT=60000

# --- OpenRouter (free ":free" models) ---
# Turn OFF training/logging for free models in Settings > Privacy first!
# AI_URL=https://openrouter.ai/api/v1/chat/completions
# AI_KEY=put_your_key_here
# AI_MODEL=some-provider/some-model:free
# CHUNK_SIZE=40000
# CHUNK_WAIT=5000

# --- Ollama (fully local: no message ever leaves your machine; needs 8 GB+ RAM) ---
# AI_URL=http://localhost:11434/v1/chat/completions
# AI_KEY=ollama
# AI_MODEL=qwen2.5:7b
# CHUNK_SIZE=12000
# CHUNK_WAIT=0

# Retries for rate limits (429) and server errors, and request timeout (ms).
# AI_MAX_RETRIES=3
# AI_TIMEOUT=120000

# ---------------------------------------------------------------------
# 2) How the bot reports  (can also be changed live: !وضع  or  PATCH /v1/settings)
# ---------------------------------------------------------------------
#   schedule = one summary at the times in SCHEDULE
#   realtime = an alert as soon as an important message shows up
#   both     = real-time alerts + the scheduled summary
MODE=schedule

# Scheduled summary, cron format: minute hour day month weekday.
#   0 21 * * *     every day at 9 PM
#   0 8,21 * * *   every day at 8 AM and 9 PM
SCHEDULE=0 21 * * *
TIMEZONE=Africa/Cairo

# Real-time mode: wait until a group has been quiet this long (ms) and check
# the new messages in ONE AI request (saves free-tier quota)...
# REALTIME_DEBOUNCE=120000
# ...but never wait longer than this after the first new message (ms).
# REALTIME_MAX_WAIT=600000

# Quiet hours: real-time alerts are held and sent together when they end.
# QUIET_HOURS=23:00-07:00
# Let urgent alerts (action needed within 48h) through anyway.
# QUIET_HOURS_ALLOW_URGENT=true

# Send summaries and alerts to your WhatsApp "Message yourself" chat.
# Set false if you only want them in the API / webhook / your dashboard.
DELIVER_TO_WHATSAPP=true

# ---------------------------------------------------------------------
# 3) Groups (optional)
# ---------------------------------------------------------------------
# Easiest way: leave this empty and use the WhatsApp commands
#   !جروبات   then   !تابع <number>
# or the API (POST /v1/groups/watched).
# If you prefer, list exact group names here separated by "|".
# This is read only on the very first run (before data/groups.json exists).
# GROUPS=Group one | Group two

# ---------------------------------------------------------------------
# 4) Keyword alerts (optional, no AI)
# ---------------------------------------------------------------------
# A watched-group message containing one of these words is forwarded to you
# instantly. Leave empty to turn off.
# URGENT_KEYWORDS=امتحان,كويز,تسليم,اتلغت,اتأجلت,ديدلاين

# ---------------------------------------------------------------------
# 5) Security of stored data
# ---------------------------------------------------------------------
# Encrypt data/*.json (messages, summaries, alerts, groups, settings) with
# AES-256-GCM. 64 hex characters (npm run secret). BACK IT UP: without it
# the data files can't be read.
# DATA_ENCRYPTION_KEY=

# How many past summaries / alerts to keep for the API (0 = keep none).
# SUMMARY_HISTORY=30
# ALERT_HISTORY=100

# Max messages kept while waiting for a summary (oldest are dropped).
# MAX_STORED_MESSAGES=5000

# ---------------------------------------------------------------------
# 6) HTTP API — connect a dashboard or another project (optional)
# ---------------------------------------------------------------------
# API_ENABLED=false
# Only this machine by default. Use a reverse proxy with HTTPS to expose it.
# Inside Docker this is set to 0.0.0.0 by docker-compose.yml.
# API_HOST=127.0.0.1
# API_PORT=3000
# Comma-separated; at least 32 characters each (npm run secret).
# Several keys let you rotate without downtime.
# API_KEYS=
# Requests per minute per IP.
# API_RATE_LIMIT=60
# Set true only behind a reverse proxy, so rate limits use the real client IP.
# API_TRUST_PROXY=false
# Browser dashboards on other origins, comma-separated (exact match).
# API_CORS_ORIGINS=https://dashboard.example.com
# Allow GET /v1/messages/pending?include=messages to return raw message text.
# API_ALLOW_RAW_MESSAGES=false

# ---------------------------------------------------------------------
# 7) Webhook — push each new summary / alert to another project (optional)
# ---------------------------------------------------------------------
# Must be https:// (http only for localhost). Requests are signed with
# HMAC-SHA256 using WEBHOOK_SECRET (see docs/API.md#webhooks).
# WEBHOOK_URL=https://your-app.example.com/hooks/whatsapp-summary
# WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# 8) Advanced (optional)
# ---------------------------------------------------------------------
# Custom AI instructions (paths to text files).
# PROMPT_FILE=prompt.txt
# REALTIME_PROMPT_FILE=realtime-prompt.txt

# Where data files and the WhatsApp session are kept.
# DATA_DIR=data
# AUTH_DIR=.wwebjs_auth

# Use a system Chromium instead of the one Puppeteer downloads.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
